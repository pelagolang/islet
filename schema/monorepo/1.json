{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pelagolang.github.io/website/schema/monorepo/1.json",
  "title": "monorepo.yaml",
  "description": "The root file of a monorepo: its members, the shared dependency table and the exceptions to one version per package. Validates the YAML data model, which matches JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "workspace"
  ],
  "properties": {
    "format": {
      "description": "Schema version of this file. Must be 1.",
      "const": 1
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members"
      ],
      "properties": {
        "members": {
          "description": "Directories or globs of member packages. Each holds an islet.yaml.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "description": "The shared dependency table (our catalog). Members point at an entry with `from: monorepo`. Values are minimum versions; the workspace resolves one version per package and major.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(/v[2-9][0-9]*)?$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/requirement"
      }
    },
    "exception": {
      "description": "Visible exceptions to one version per package and major. Each is a deliberate, reviewed split.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": {
          "description": "A shared cache location. Entries are content-addressed and signed.",
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "requirement": {
      "oneOf": [
        {
          "$ref": "#/$defs/semver"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/semver"
            },
            "package": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 64
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "members",
        "reason"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(/v[2-9][0-9]*)?$"
        },
        "version": {
          "description": "The exact version these members keep.",
          "$ref": "#/$defs/semver"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "description": "Why the split exists. Shown in review.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  }
}
